# SmartCore public HTTPS boundary.
# Only POST /feishu/event is forwarded to the app container.
# /dashboard, /admin, /api, /docs, /backup and all other paths return 404.

{
	email {$CADDY_ADMIN_EMAIL:admin@example.com}
}

{$DOMAIN} {
	handle /feishu/event {
		reverse_proxy app:8000
	}

	handle {
		respond "Not Found" 404
	}
}
