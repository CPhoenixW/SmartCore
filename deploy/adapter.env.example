# Copy to deploy/adapter.env on the server. Never commit the real file.
HOST=172.18.0.1
PORT=18790
OPENCLAW_EVENTS_TOKEN=replace-me
OPENCLAW_BIN=/root/.openclaw/bin/openclaw
# Text messages and file-only messages use the DeepSeek profile. Image messages use
# the isolated Qwen profile selected by the Adapter.
OPENCLAW_AGENT_ID=smartcore
OPENCLAW_TEXT_AGENT_ID=smartcore
OPENCLAW_VISION_AGENT_ID=smartcore-vision
OPENCLAW_SESSION_PREFIX=agent:smartcore:smartcore-rollback
OPENCLAW_VISION_SESSION_PREFIX=agent:smartcore-vision:smartcore-rollback
OPENCLAW_TEXT_MODEL=tokendance/deepseek-v4-flash-0731
OPENCLAW_VISION_MODEL=tokendance/qwen3.7-plus
SMARTCORE_BASE_URL=http://your-server-tailscale-ip:8000
OPENCLAW_THINKING=low
OPENCLAW_WORKSPACE=/root/.openclaw-smartcore-workspace
SMARTCORE_AGENT_TOKEN_FILE=/root/.openclaw/smartcore-agent-api-token
# Images are staged into the shared OpenClaw workspace and sent to the
# smartcore Agent's native multimodal model. Documents remain storage-only.
OPENCLAW_IMAGE_MAX_BYTES=10485760
OPENCLAW_TIMEOUT_SECONDS=600
