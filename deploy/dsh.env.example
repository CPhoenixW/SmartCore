# Copy to deploy/dsh.env on the server. Never commit the real file.
HOST=0.0.0.0
PORT=18790
DSH_EVENTS_TOKEN=replace-me
SMARTCORE_BASE_URL=http://app:8000
SMARTCORE_AGENT_TOKEN=replace-me

# DSH's Pi-AI route speaks an OpenAI-compatible streaming Chat Completions API.
LLM_PROVIDER=tokendance
LLM_API_KEY=replace-me
LLM_BASE_URL=https://tokendance.space/gateway/v1
LLM_MODEL=deepseek-v4-flash-0731
DSH_PROVIDER=tokendance
