# Copy to deploy/.env and fill in real values on the server.
# Do not commit .env or passwd.txt.

# Docker Compose host bindings (see deploy/docker-compose.yml)
# APP_BIND: where app :8000 is published on the host (internal dashboard / healthz).
# Production: set to the server's Tailscale IPv4 so phones/laptops reach /work over tailnet.
APP_BIND=127.0.0.1
# TUNNEL_BOUNDARY_BIND: where tunnel-boundary :80 is published as host :8000 for Cloudflare Tunnel.
# Default is docker0 bridge gateway; change only if your bridge IP is not 172.17.0.1.
TUNNEL_BOUNDARY_BIND=172.17.0.1

# Public domain for Caddy HTTPS (Feishu callback URL host)
DOMAIN=your-domain.example.com
CADDY_ADMIN_EMAIL=admin@example.com

# Application
APP_NAME=SmartCore
DEBUG=false
PUBLIC_ACCESS_ENABLED=false
# When enabling public access, set the exact HTTPS origin (no trailing slash).
PUBLIC_ORIGIN=https://your-domain.example.com
AUTH_REGISTRATION_ENABLED=false
AUTH_SETUP_ENABLED=false
AUTH_COOKIE_SECURE=true
# Inspect the actual Docker networks first. Do not trust arbitrary forwarded headers.
# App trusts only Caddy's source IP/subnet; Caddy trusts only cloudflared's source IP/subnet.
TRUSTED_PROXY_NETWORKS=
TUNNEL_PROXY_NETWORK=127.0.0.1/32
DATABASE_URL=sqlite:////app/data/smartcore.sqlite

# Feishu bot placeholders
FEISHU_APP_ID=replace-me
FEISHU_APP_SECRET=replace-me
FEISHU_VERIFICATION_TOKEN=replace-me
FEISHU_ENCRYPT_KEY=replace-me
FEISHU_DEFAULT_CHAT_ID=replace-me
FEISHU_REPLAY_MAX_AGE_SECONDS=300

# OpenClaw bridge
# The Compose Adapter uses host networking and retains the existing docker-bridge address.
OPENCLAW_EVENTS_ENDPOINT=http://172.18.0.1:18790/api/smartcore/events
OPENCLAW_EVENTS_TOKEN=replace-me

# SmartCore Agent API token
AGENT_API_TOKEN=replace-me

# Device state token
DEVICE_API_TOKEN=replace-me
COMPUTER_ACTIVITY_RETENTION_DAYS=90

# Natural-language gateway used by every model call owned by SmartCore.
# Store the real API key only in deploy/.env.
LLM_PROVIDER=tokendance
LLM_API_KEY=replace-me
LLM_BASE_URL=https://tokendance.space/gateway/v1
LLM_MODEL=deepseek-v4-flash-0731
# Native multimodal image requests use Qwen. Documents never enter this model.
VISION_MODEL=qwen3.7-plus
IDEA_MEDIA_DIR=/app/data/idea_media
IDEA_MEDIA_MAX_BYTES=20971520
VISION_MAX_IMAGE_BYTES=10485760
LLM_MAX_RETRIES=2

# Compatibility only. Existing deployments may leave the key in DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# Historical setting name used by Feishu cards; the current workbench path is /work.
DASHBOARD_BASE_URL=http://your-server-tailscale-ip:8000/work

# Academic calendar (ISO date, optional)
SEMESTER_START=2026-02-24

# Active reminder scheduler
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60
DAILY_SUMMARY_ENABLED=false
DAILY_SUMMARY_HOUR=23
DAILY_SUMMARY_MINUTE=59
DAILY_SUMMARY_TIMEZONE=Asia/Shanghai
COMPUTER_ANALYSIS_ENABLED=false
COMPUTER_ANALYSIS_TIMEZONE=Asia/Shanghai
COMPUTER_ANALYSIS_MINUTE=5
# Computer annotations use one bounded Flash request. OpenClaw fallback and daytime log previews
# stay off by default to prevent unattended tasks from expanding into multi-turn agent runs.
COMPUTER_ANALYSIS_DIRECT_LLM_ENABLED=true
COMPUTER_ANALYSIS_MODEL=deepseek-v4-flash-0731
# 0731 needs room for reasoning before its structured JSON response.
COMPUTER_ANALYSIS_MAX_OUTPUT_TOKENS=8192
COMPUTER_ANALYSIS_OPENCLAW_FALLBACK_ENABLED=false
COMPUTER_DAILY_PREVIEW_ENABLED=false
COMPUTER_DAILY_PREVIEW_MIN_INTERVAL_MINUTES=240
WEATHER_ENABLED=false
WEATHER_REFRESH_MINUTES=30
WEATHER_DAILY_HOUR=22
WEATHER_DAILY_MINUTE=0
WEATHER_TIMEZONE=Asia/Shanghai
WEATHER_LOCATION_NAME=杭州市钱塘区
WEATHER_LATITUDE=30.284
WEATHER_LONGITUDE=120.493
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Computer work-block analysis is additive and remains disabled until candidate validation passes.
COMPUTER_WORK_BLOCK_ANALYSIS_ENABLED=false
COMPUTER_ATTENTION_REMINDERS_ENABLED=false
COMPUTER_ATTENTION_IDLE_MINUTES=5
COMPUTER_IMPLICIT_FOCUS_ACTIVE_MINUTES=20

# Backup and Raspberry Pi sync
BACKUP_DIR=/app/backups
PI_USER=pi
PI_HOST=raspberrypi-tailnet-name
PI_BACKUP_DIR=/home/pi/smartcore-backups
LOCAL_BACKUP_RETENTION_DAYS=30
PI_BACKUP_RETENTION_DAYS=90
