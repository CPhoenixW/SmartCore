# Copy to deploy/.env and fill in real values on the server.
# Do not commit .env or passwd.txt.

# Docker Compose host bindings (see deploy/docker-compose.yml)
# APP_BIND: where app :8000 is published on the host (internal dashboard / healthz).
# Production: set to the server's Tailscale IPv4 so phones/laptops reach /dashboard over tailnet.
APP_BIND=127.0.0.1
# TUNNEL_BOUNDARY_BIND: where tunnel-boundary :80 is published as host :8000 for Cloudflare Tunnel.
# Default is docker0 bridge gateway; change only if your bridge IP is not 172.17.0.1.
TUNNEL_BOUNDARY_BIND=172.17.0.1

# Public domain for Caddy HTTPS (Feishu callback URL host)
DOMAIN=your-domain.example.com
CADDY_ADMIN_EMAIL=admin@example.com

# Application
APP_NAME=SmartCore
DEBUG=false
DATABASE_URL=sqlite:////app/data/smartcore.sqlite

# Feishu bot (placeholder values only)
FEISHU_APP_ID=cli_xxxxxxxxxx
FEISHU_APP_SECRET=your-app-secret
FEISHU_VERIFICATION_TOKEN=your-verification-token
FEISHU_ENCRYPT_KEY=your-encrypt-key
FEISHU_DEFAULT_CHAT_ID=oc_xxxxxxxxxx
FEISHU_REPLAY_MAX_AGE_SECONDS=300

# OpenClaw bridge
# When configured, SmartCore forwards accepted Feishu messages/card callbacks to
# OpenClaw and no longer runs SmartCore's local natural-language parser for them.
OPENCLAW_EVENTS_ENDPOINT=http://openclaw:3000/api/smartcore/events
OPENCLAW_EVENTS_TOKEN=your-openclaw-shared-secret

# SmartCore Agent API token. OpenClaw must send it as:
# X-SmartCore-Agent-Token: <value>
AGENT_API_TOKEN=your-smartcore-agent-token

# Legacy local LLM parser fallback. Leave disabled in production when OpenClaw
# owns natural-language understanding.
LLM_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Internal dashboard URL used by Feishu cards for "modify command".
DASHBOARD_BASE_URL=http://your-server-tailscale-ip:8000/dashboard

# Academic calendar (ISO date, optional)
SEMESTER_START=2026-02-24

# Active reminder scheduler
# Keep false for local development unless you want background reminder ticks.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60

# Backup and Raspberry Pi sync (Tailscale hostnames recommended)
BACKUP_DIR=/app/backups
PI_USER=pi
PI_HOST=raspberrypi-tailnet-name
PI_BACKUP_DIR=/home/pi/smartcore-backups
LOCAL_BACKUP_RETENTION_DAYS=30
PI_BACKUP_RETENTION_DAYS=90
