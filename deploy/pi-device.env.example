# SmartCore server-side Pi/device settings.
# Copy these values into deploy/.env and replace the token.

DEVICE_API_TOKEN=replace-with-a-long-random-token
DEVICE_HEARTBEAT_INTERVAL_SECONDS=10
DEVICE_PHOTO_REQUEST_TTL_SECONDS=300
DEVICE_PHOTO_MAX_BYTES=10485760
DEVICE_PHOTO_DIR=/app/data/device_photos
